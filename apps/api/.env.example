# Copy to .env for local development (never commit .env).
PORT=3000
# Directory with the four CSV exports, relative to apps/api.
DATA_DIR=../../data
EXPORT_DATE=2026-10-01
# Optional locally, mandatory in production (NODE_ENV=production). Password: min. 12 characters.
# BASIC_AUTH_USER=hr
# BASIC_AUTH_PASSWORD=
LOG_LEVEL=info
